{
  "name": "draw-guess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "cd worker && npx wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\" \"tests/unit/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\" \"tests/unit/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\" \"tests/unit/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\" \"tests/unit/**/*.ts\"",
    "deploy:worker": "cd worker && npx wrangler deploy",
    "deploy:pages": "npm run build && node worker/node_modules/wrangler/bin/wrangler.js pages deploy dist --project-name=draw-guess --commit-message=cli-deploy",
    "deploy:all": "npm run deploy:worker && npm run deploy:pages",
    "test": "vitest run",
    "test:protocol": "node tests/regression/run.cjs protocol",
    "test:browser": "node tests/regression/run.cjs browser"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@twind/core": "^1.1.3",
    "@twind/preset-autoprefix": "^1.0.7",
    "@twind/preset-tailwind": "^1.1.4",
    "@uiw/react-color": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
