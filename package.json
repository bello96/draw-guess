{
  "name": "draw-guess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "cd worker && npx wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"worker/src/**/*.ts\"",
    "deploy:worker": "cd worker && npx wrangler deploy",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name=draw-guess",
    "deploy:all": "npm run deploy:worker && npm run deploy:pages"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@twind/core": "^1.1.3",
    "@twind/preset-autoprefix": "^1.0.7",
    "@twind/preset-tailwind": "^1.1.4",
    "@uiw/react-color": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
